# TMDB는 서버(Route Handler, generateMetadata)에서만 호출해요. NEXT_PUBLIC_을 붙이지 않아 브라우저에 노출되지 않아요.
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_ACCESS_TOKEN=YOUR_TMDB_API_READ_ACCESS_TOKEN

# 우리 백엔드(NestJS)를 부르는 주소예요. 브라우저 코드에서 읽어서 NEXT_PUBLIC_이 필요해요.
# - 로컬 개발: 백엔드를 직접 호출 → http://localhost:3000
# - Vercel 배포: 같은 사이트의 /api/umc 로 호출하고, Next.js가 UMC_API_ORIGIN으로 전달(rewrite) → /api/umc
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# (배포용, 서버 전용) rewrite가 전달할 실제 백엔드 주소. 로컬 개발에서는 비워 둬요. 예) http://{EC2_PUBLIC_IP}:3000
UMC_API_ORIGIN=

# 로컬 개발용 (.env.local로 복사해서 사용, Git에 올리지 않아요)
NODE_ENV=local
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=본인_MySQL_비밀번호
DB_NAME=umc_movie

# 토큰 서명에 쓰는 비밀키와 Access Token 유효시간(초)
# JWT_SECRET은 32자 이상의 무작위 문자열로 직접 채워요. (예: openssl rand -base64 48) 비어 있거나 짧으면 서버가 켜지지 않아요.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600

# CORS로 허용할 프론트 주소 (여러 개면 쉼표로 구분)
FRONTEND_ORIGIN=http://localhost:5173

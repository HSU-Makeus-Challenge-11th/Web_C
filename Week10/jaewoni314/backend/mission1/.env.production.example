# 운영(EC2)용 키 목록이에요. 공유해도 되는 값만 적고 비밀 값은 비워 둬요.
# 실제 값은 EC2의 ~/movie-app/.env.production(권한 600)에만 두고 Git에 올리지 않아요.
NODE_ENV=production
PORT=3000
DB_HOST=RDS_엔드포인트
DB_PORT=3306
DB_USER=movie_app
DB_PASSWORD=
DB_NAME=umc_movie

JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600

# 배포된 프론트 주소. Vercel(HTTPS)은 Next.js 서버가 대신 호출하지만, 로컬 프론트도 함께 허용해 둬요.
FRONTEND_ORIGIN=https://배포된_프론트_주소,http://localhost:5173
